#!/usr/bin/make -f

export DH_VERBOSE = 1

DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
DEB_BUILD_ARCH ?= $(shell dpkg-architecture -qDEB_BUILD_ARCH)
UPSTREAM_VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//')
PACKAGE_ROOT := debian/tdns
COMMON_DIR := packaging/common

ifeq ($(DEB_HOST_ARCH),amd64)
TDNS_COMPONENT := amd64
TDNS_MACHINE_PATTERN := x86-64
else ifeq ($(DEB_HOST_ARCH),arm64)
TDNS_COMPONENT := arm64
TDNS_MACHINE_PATTERN := ARM aarch64
else ifeq ($(DEB_HOST_ARCH),armhf)
TDNS_COMPONENT := armhf
TDNS_MACHINE_PATTERN := ARM, EABI5
else
$(error Unsupported Debian architecture $(DEB_HOST_ARCH))
endif

TDNS_BINARY := $(CURDIR)/$(TDNS_COMPONENT)/tdns

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_clean:

override_dh_auto_build:

override_dh_auto_test:
	test "$(DEB_BUILD_ARCH)" = "$(DEB_HOST_ARCH)"
	test -x "$(TDNS_BINARY)"
	file -b "$(TDNS_BINARY)" | grep -Fq "$(TDNS_MACHINE_PATTERN)"
	file -b "$(TDNS_BINARY)" | grep -Eq "statically linked.*stripped"
	"$(TDNS_BINARY)" --version | grep -Fq "tdns version $(UPSTREAM_VERSION)"

override_dh_auto_install:
	install -D -m 0755 "$(TDNS_BINARY)" "$(PACKAGE_ROOT)/usr/bin/tdns"
	install -d -m 0755 "$(PACKAGE_ROOT)/usr/share/man/man1"
	"$(TDNS_BINARY)" man --output-dir "$(PACKAGE_ROOT)/usr/share/man/man1"
	install -D -m 0644 "$(COMMON_DIR)/tdns.sysusers" "$(PACKAGE_ROOT)/usr/lib/sysusers.d/tdns.conf"
	install -D -m 0644 "$(COMMON_DIR)/tdns.tmpfiles" "$(PACKAGE_ROOT)/usr/lib/tmpfiles.d/tdns.conf"
	install -d -m 0750 "$(PACKAGE_ROOT)/etc/tdns"
	install -d -m 0750 "$(PACKAGE_ROOT)/var/lib/tdns"

override_dh_installtmpfiles:

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade tdns.service

# The release binary is already stripped. Reprocessing it would break byte-for-
# byte correspondence with the verified GoReleaser artifact.
override_dh_strip:
